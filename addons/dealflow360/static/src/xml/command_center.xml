<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dealflow360.CommandCenter" owl="1">
        <div class="o_action_manager o_dealflow_command_center bg-view p-4" style="height: 100%; overflow-y: auto;">
            
            <!-- Loading State -->
            <div t-if="state.isLoading" class="d-flex flex-column justify-content-center align-items-center h-100 py-5">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="text-muted fw-bold">Loading DealFlow360...</h5>
            </div>
            
            <!-- Error State -->
            <div t-elif="state.hasError" class="container-fluid py-5">
                <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center p-4" role="alert">
                    <i class="fa fa-exclamation-circle fa-2x me-3"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">Unable to load DealFlow360 dashboard.</h5>
                        <p class="mb-0 text-muted">Please check your backend permissions or database status and click retry.</p>
                        <button class="btn btn-outline-danger btn-sm mt-3" t-on-click="loadData">
                            <i class="fa fa-refresh me-1"></i> Retry
                        </button>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div t-else="" class="container-fluid">
                <!-- Header Section -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3">
                            <div>
                                <h1 class="text-primary mb-1 fw-bold">DealFlow360</h1>
                                <h4 class="text-dark mb-1 fw-semibold">Intelligent Deal Operations</h4>
                                <p class="text-muted mb-0">Monitor deal risk, approvals, pipeline and intelligent recommendations.</p>
                            </div>
                            <div>
                                <button class="btn btn-light border shadow-sm btn-sm" t-on-click="loadData" title="Refresh Dashboard">
                                    <i class="fa fa-refresh me-1 text-primary"></i> Refresh
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPIs Row -->
                <div class="row g-4 mb-4">
                    <!-- Active Deals -->
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 cursor-pointer text-decoration-none text-reset" t-on-click="() => this.openSaleOrders('active')">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Active Deals</h6>
                                <h2 class="display-5 fw-bold text-primary mb-0"><t t-esc="state.data.kpis.active_deals"/></h2>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Pipeline Value -->
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 cursor-pointer text-decoration-none text-reset" t-on-click="() => this.openSaleOrders('active')">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Pipeline Value</h6>
                                <h2 class="display-6 fw-bold text-success mb-0">
                                    <t t-if="state.data.kpis.currency_position === 'after'">
                                        <t t-esc="formatCurrency(state.data.kpis.pipeline_value)"/> <t t-esc="state.data.kpis.currency_symbol"/>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="state.data.kpis.currency_symbol"/><t t-esc="formatCurrency(state.data.kpis.pipeline_value)"/>
                                    </t>
                                </h2>
                            </div>
                        </div>
                    </div>

                    <!-- Pending Approvals -->
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 cursor-pointer text-decoration-none text-reset" t-on-click="() => this.openPendingApprovals()">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Pending Approvals</h6>
                                <h2 class="display-5 fw-bold text-warning mb-0"><t t-esc="state.data.kpis.pending_approvals"/></h2>
                            </div>
                        </div>
                    </div>

                    <!-- High Risk Deals -->
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 cursor-pointer text-decoration-none text-reset" t-on-click="() => this.openSaleOrders('high_risk')">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">High Risk Deals</h6>
                                <h2 class="display-5 fw-bold text-danger mb-0"><t t-esc="state.data.kpis.high_risk_deals"/></h2>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <!-- Deals Requiring Attention -->
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                                <h4 class="mb-0 fw-bold"><i class="fa fa-exclamation-triangle text-warning me-2"></i> Deals Requiring Attention</h4>
                            </div>
                            <div class="card-body p-0">
                                <div t-if="state.data.attention_deals.length === 0" class="p-5 text-center text-muted">
                                    <i class="fa fa-check-circle-o fa-3x mb-3 text-success"></i>
                                    <h5>No deals requiring attention.</h5>
                                    <p class="mb-0 text-muted">All active quotations are within acceptable risk thresholds.</p>
                                </div>
                                <div t-else="" class="table-responsive">
                                    <table class="table table-hover table-borderless align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-4">Quotation</th>
                                                <th>Customer</th>
                                                <th>Amount</th>
                                                <th>Risk Score</th>
                                                <th>Approval Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.data.attention_deals" t-as="deal" t-key="deal.id" class="cursor-pointer" t-on-click="() => this.openSaleOrder(deal.id)">
                                                <td class="ps-4 fw-bold text-primary"><t t-esc="deal.name"/></td>
                                                <td><t t-esc="deal.customer"/></td>
                                                <td class="fw-bold"><t t-esc="deal.currency_symbol"/><t t-esc="formatCurrency(deal.amount_total)"/></td>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill text-bg-{{ deal.risk_level === 'high' ? 'danger' : (deal.risk_level === 'medium' ? 'warning' : 'success') }}">
                                                        <t t-esc="deal.risk_score"/> (<t t-esc="deal.risk_level"/>)
                                                    </span>
                                                </td>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill text-bg-{{ deal.approval_status === 'approved' ? 'success' : (deal.approval_status === 'rejected' ? 'danger' : (deal.approval_status === 'pending' ? 'warning' : 'secondary')) }}">
                                                        <t t-esc="deal.approval_status === 'none' ? 'None' : deal.approval_status"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Approvals and Recommendations -->
                    <div class="col-lg-4">
                        <div class="d-flex flex-column h-100 gap-4">
                            <!-- Pending Approvals -->
                            <div class="card shadow-sm border-0 flex-grow-1">
                                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold"><i class="fa fa-clock-o text-warning me-2"></i> Pending Approvals</h5>
                                    <button class="btn btn-link btn-sm text-decoration-none p-0" t-on-click="() => this.openPendingApprovals()">View All</button>
                                </div>
                                <div class="card-body p-0">
                                    <div t-if="state.data.pending_approvals_list.length === 0" class="p-4 text-center text-muted">
                                        <p class="mb-0 fs-6">No pending approvals.</p>
                                    </div>
                                    <div t-else="" class="list-group list-group-flush">
                                        <div t-foreach="state.data.pending_approvals_list" t-as="app" t-key="app.id" class="list-group-item list-group-item-action cursor-pointer p-3" t-on-click="() => this.openApproval(app.id)">
                                            <div class="d-flex w-100 justify-content-between mb-1">
                                                <h6 class="mb-0 fw-bold text-primary"><t t-esc="app.order_name"/></h6>
                                                <small class="text-muted"><t t-esc="app.create_date"/></small>
                                            </div>
                                            <p class="mb-1 text-truncate small text-secondary"><t t-esc="app.customer"/></p>
                                            <div class="d-flex justify-content-between align-items-center mt-2">
                                                <span class="badge text-bg-warning"><t t-esc="app.current_step"/></span>
                                                <span class="text-danger fw-bold"><i class="fa fa-fire me-1"></i> <t t-esc="app.risk_score"/></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Smart Recommendations Summary -->
                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold"><i class="fa fa-lightbulb-o text-info me-2"></i> Smart Recommendations</h5>
                                    <button class="btn btn-link btn-sm text-decoration-none p-0" t-on-click="() => this.openRecommendationRules()">Configure</button>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center p-3 rounded bg-light border cursor-pointer mb-3" t-on-click="() => this.openRecommendationRules()">
                                        <span class="fw-bold text-dark">Active Configured Rules</span>
                                        <span class="badge bg-primary fs-6"><t t-esc="state.data.recommendations_summary.active_rules"/></span>
                                    </div>
                                    <div t-if="state.data.recommendations_summary.rules_list and state.data.recommendations_summary.rules_list.length &gt; 0">
                                        <small class="text-muted fw-bold text-uppercase d-block mb-2">Configured Rule Samples</small>
                                        <ul class="list-group list-group-flush small">
                                            <li t-foreach="state.data.recommendations_summary.rules_list" t-as="rule" t-key="rule.id" class="list-group-item px-0 py-1 bg-transparent d-flex justify-content-between align-items-center">
                                                <span class="text-truncate" style="max-width: 180px;"><t t-esc="rule.name"/></span>
                                                <span t-attf-class="badge text-bg-{{ rule.type_label === 'Upsell' ? 'info' : 'secondary' }}"><t t-esc="rule.type_label"/></span>
                                            </li>
                                        </ul>
                                    </div>
                                    <div t-else="" class="text-muted small text-center py-2">
                                        No active recommendation rules.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </t>
</templates>

