<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dealflow360.RecommendationsWidget">
        <div class="dealflow_recommendations_panel mb-4" t-if="recommendations.length > 0">
            <h4 class="mb-1 text-primary"><i class="fa fa-lightbulb-o me-2"/>Smart Opportunities</h4>
            <p class="text-muted small mb-3">Products that may increase deal value or customer fit.</p>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                <t t-foreach="recommendations" t-as="rec" t-key="rec.id">
                    <div class="col">
                        <div class="card h-100 border shadow-sm" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title text-truncate mb-0" t-esc="rec.product_name" t-att-title="rec.product_name"/>
                                    <span t-attf-class="badge rounded-pill {{ rec.type === 'upsell' ? 'text-bg-success' : 'text-bg-info' }}" t-esc="rec.type_label"/>
                                </div>
                                <p class="card-text text-muted small mb-3" t-esc="rec.reason"/>
                                <div class="d-flex flex-column mb-3">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Revenue</span>
                                        <span class="fw-bold text-success">+<t t-esc="rec.currency_symbol"/><t t-esc="rec.revenue"/></span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Margin</span>
                                        <span class="fw-bold text-primary">+<t t-esc="rec.currency_symbol"/><t t-esc="rec.margin"/></span>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary w-100" t-on-click="() => this.onAddProduct(rec.product_id)" t-att-disabled="state.addingProductId">
                                    <t t-if="state.addingProductId === rec.product_id">
                                        <i class="fa fa-spinner fa-spin me-1"/> Adding...
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-plus me-1"/> Add to Order
                                    </t>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
