<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dealflow360.RecommendationsWidget">
        <div class="dealflow_recommendations_panel mb-4" t-if="recommendations.length > 0">
            <h5 class="fw-bold text-dark mb-3"><i class="fa fa-magic text-warning me-2"/>Smart Opportunities</h5>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                <t t-foreach="recommendations" t-as="rec" t-key="rec.id">
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4" style="background: linear-gradient(145deg, #ffffff, #f8f9fa); transition: all 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.08)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.125rem 0.25rem rgba(0,0,0,0.075)';">
                            <div class="card-body p-4">
                                <span t-attf-class="badge rounded-1 fs-6 mb-3 {{ rec.type === 'upsell' ? 'text-success bg-success-subtle' : 'text-info bg-info-subtle' }}" t-esc="rec.type_label.toUpperCase()"/>
                                <h4 class="card-title fw-bold text-dark mb-1" t-esc="rec.product_name" t-att-title="rec.product_name"/>
                                <p class="card-text text-muted mb-4" style="font-size: 0.95rem; font-style: italic;">"<t t-esc="rec.reason"/>"</p>
                                
                                <button type="button" class="btn btn-outline-primary fw-bold w-100 rounded-pill" t-on-click="() => this.onAddProduct(rec.product_id)" t-att-disabled="state.addingProductId">
                                    <t t-if="state.addingProductId === rec.product_id">
                                        <i class="fa fa-spinner fa-spin me-2"/> Adding...
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-plus me-2"/> Add to Order
                                    </t>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
