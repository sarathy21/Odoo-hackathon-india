<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dealflow360.SalesRepWorkspace" owl="1">
        <div class="o_action_manager o_dealflow_sales_workspace bg-view p-4" style="height: 100%; overflow-y: auto;">
            
            <!-- Loading State -->
            <div t-if="state.isLoading" class="d-flex flex-column justify-content-center align-items-center h-100 py-5">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="text-muted fw-bold">Loading Sales Workspace...</h5>
            </div>
            
            <!-- Error State -->
            <div t-elif="state.hasError" class="container-fluid py-5">
                <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center p-4" role="alert">
                    <i class="fa fa-exclamation-circle fa-2x me-3"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1"><t t-esc="state.errorMessage"/></h5>
                        <button class="btn btn-outline-danger btn-sm mt-3" t-on-click="loadData">
                            <i class="fa fa-refresh me-1"></i> Retry
                        </button>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div t-else="" class="container-fluid">
                <!-- Header Section -->
                <div class="row mb-5 mt-3">
                    <div class="col-12 text-center">
                        <h5 class="text-uppercase text-muted fw-bold tracking-wide mb-2" style="letter-spacing: 2px;">DealFlow360</h5>
                        <h1 class="display-5 fw-bold text-dark mb-3">Sales Workspace</h1>
                        <p class="text-secondary fs-5 mb-4">Manage your quotations and focus on what matters.</p>
                        <button class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill fw-bold" t-on-click="createQuotation" style="font-size: 1.1rem;">
                            <i class="fa fa-plus me-2"></i> New Quotation
                        </button>
                    </div>
                </div>

                <!-- KPIs Row -->
                <div class="row g-4 mb-5 justify-content-center">
                    <!-- My Quotations -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 rounded-4 text-center cursor-pointer" style="transition: all 0.2s; background: #ffffff;" t-on-click="() => this.openFilteredDeals('draft')" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.08)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.125rem 0.25rem rgba(0,0,0,0.075)';">
                            <div class="card-body p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.85rem; letter-spacing: 1px;">My Quotes</h6>
                                <h2 class="display-4 fw-bold text-dark mb-0"><t t-esc="state.data.kpis.my_quotations"/></h2>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Orders -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 rounded-4 text-center cursor-pointer" style="transition: all 0.2s; background: #ffffff;" t-on-click="() => this.openFilteredDeals('sale')" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.08)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.125rem 0.25rem rgba(0,0,0,0.075)';">
                            <div class="card-body p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-3" style="font-size: 0.85rem; letter-spacing: 1px;">Orders</h6>
                                <h2 class="display-4 fw-bold text-dark mb-0"><t t-esc="state.data.kpis.orders"/></h2>
                            </div>
                        </div>
                    </div>

                    <!-- Needs Attention -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 rounded-4 text-center cursor-pointer" style="transition: all 0.2s; background: #fff5f5;" t-on-click="() => this.openFilteredDeals('high_risk')" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 20px rgba(220,53,69,0.15)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.125rem 0.25rem rgba(0,0,0,0.075)';">
                            <div class="card-body p-4">
                                <h6 class="text-danger text-uppercase fw-bold mb-3" style="font-size: 0.85rem; letter-spacing: 1px;">Attention</h6>
                                <h2 class="display-4 fw-bold text-danger mb-0"><t t-esc="state.data.kpis.high_risk"/></h2>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Pending Approval -->
                    <div class="col-6 col-md-3">
                        <div class="card h-100 shadow-sm border-0 rounded-4 text-center cursor-pointer" style="transition: all 0.2s; background: #fffdf5;" t-on-click="() => this.openPendingApprovals()" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 20px rgba(255,193,7,0.15)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.125rem 0.25rem rgba(0,0,0,0.075)';">
                            <div class="card-body p-4">
                                <h6 class="text-warning text-uppercase fw-bold mb-3" style="font-size: 0.85rem; letter-spacing: 1px;">Approvals</h6>
                                <h2 class="display-4 fw-bold text-warning mb-0"><t t-esc="state.data.kpis.pending_approvals"/></h2>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- My Deals Section -->
                <div class="row mb-5">
                    <div class="col-12">
                        <h4 class="fw-bold mb-4 text-dark">My Deals</h4>
                        <div class="card shadow-sm border-0 rounded-4">
                            <div class="card-body p-0">
                                <div t-if="state.data.my_deals.length === 0" class="p-5 text-center text-muted">
                                    <i class="fa fa-file-text-o fa-3x mb-3 text-secondary"></i>
                                    <h5>No deals available.</h5>
                                    <p class="mb-0 text-muted">You do not have any active quotations or orders assigned to you.</p>
                                </div>
                                <div t-else="" class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" style="font-size: 1.05rem;">
                                        <thead style="background: #f8f9fa;">
                                            <tr>
                                                <th class="ps-4 py-3 text-muted fw-semibold border-bottom-0">Quotation</th>
                                                <th class="py-3 text-muted fw-semibold border-bottom-0">Customer</th>
                                                <th class="py-3 text-muted fw-semibold border-bottom-0">Amount</th>
                                                <th class="py-3 text-muted fw-semibold border-bottom-0">Risk</th>
                                                <th class="py-3 text-muted fw-semibold border-bottom-0">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.data.my_deals" t-as="deal" t-key="deal.id" t-attf-class="cursor-pointer align-middle border-bottom" t-on-click="() => this.openDeal(deal.id)">
                                                <td class="ps-4 py-3 fw-bold text-dark"><t t-esc="deal.name"/></td>
                                                <td class="py-3 text-secondary"><t t-esc="deal.customer"/></td>
                                                <td class="py-3 fw-bold text-dark">
                                                    <t t-if="state.data.kpis.currency_position === 'after'">
                                                        <t t-esc="formatCurrency(deal.amount_total)"/> <t t-esc="deal.currency_symbol"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="deal.currency_symbol"/><t t-esc="formatCurrency(deal.amount_total)"/>
                                                    </t>
                                                </td>
                                                <td class="py-3">
                                                    <span t-attf-class="badge rounded-1 fs-6 text-uppercase fw-bold {{ deal.risk_level === 'high' ? 'text-danger bg-danger-subtle' : (deal.risk_level === 'medium' ? 'text-warning bg-warning-subtle' : 'text-success bg-success-subtle') }}">
                                                        <t t-esc="deal.risk_level.toUpperCase()"/>
                                                    </span>
                                                </td>
                                                <td class="py-3">
                                                    <span class="text-secondary fw-semibold">
                                                        <t t-esc="deal.approval_status === 'none' ? (deal.state === 'sale' ? 'Order' : 'Draft/Sent') : deal.approval_status.toUpperCase()"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </t>
</templates>
