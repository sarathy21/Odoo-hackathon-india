<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dealflow360.SalesRepWorkspace" owl="1">
        <div class="o_action_manager o_dealflow_sales_workspace bg-view p-4" style="height: 100%; overflow-y: auto;">
            
            <!-- Loading State -->
            <div t-if="state.isLoading" class="d-flex flex-column justify-content-center align-items-center h-100 py-5">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="text-muted fw-bold">Loading Sales Workspace...</h5>
            </div>
            
            <!-- Error State -->
            <div t-elif="state.hasError" class="container-fluid py-5">
                <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center p-4" role="alert">
                    <i class="fa fa-exclamation-circle fa-2x me-3"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1"><t t-esc="state.errorMessage"/></h5>
                        <button class="btn btn-outline-danger btn-sm mt-3" t-on-click="loadData">
                            <i class="fa fa-refresh me-1"></i> Retry
                        </button>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div t-else="" class="container-fluid">
                <!-- Header Section -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3">
                            <div>
                                <h1 class="text-primary mb-1 fw-bold">DealFlow360</h1>
                                <h4 class="text-dark mb-1 fw-semibold">Sales Representative Workspace</h4>
                                <p class="text-muted mb-0">Create, manage and govern your customer deals.</p>
                            </div>
                            <div>
                                <button class="btn btn-primary shadow-sm" t-on-click="createQuotation">
                                    <i class="fa fa-plus me-1"></i> Create Quotation
                                </button>
                                <button class="btn btn-light border shadow-sm ms-2" t-on-click="loadData" title="Refresh Workspace">
                                    <i class="fa fa-refresh text-primary"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPIs Row -->
                <div class="row g-4 mb-4">
                    <!-- My Quotations -->
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 cursor-pointer text-decoration-none text-reset" t-on-click="() => this.openFilteredDeals('draft')">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">My Quotations</h6>
                                <h2 class="display-5 fw-bold text-primary mb-0"><t t-esc="state.data.kpis.my_quotations"/></h2>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Pending Approval -->
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 cursor-pointer text-decoration-none text-reset" t-on-click="() => this.openPendingApprovals()">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Pending Approval</h6>
                                <h2 class="display-5 fw-bold text-warning mb-0"><t t-esc="state.data.kpis.pending_approvals"/></h2>
                            </div>
                        </div>
                    </div>

                    <!-- High Risk -->
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 cursor-pointer text-decoration-none text-reset" t-on-click="() => this.openFilteredDeals('high_risk')">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">High Risk</h6>
                                <h2 class="display-5 fw-bold text-danger mb-0"><t t-esc="state.data.kpis.high_risk"/></h2>
                            </div>
                        </div>
                    </div>

                    <!-- Orders -->
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 cursor-pointer text-decoration-none text-reset" t-on-click="() => this.openFilteredDeals('sale')">
                            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Orders</h6>
                                <h2 class="display-5 fw-bold text-success mb-0"><t t-esc="state.data.kpis.orders"/></h2>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- My Deals Section -->
                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                                <h4 class="mb-0 fw-bold"><i class="fa fa-list text-primary me-2"></i> My Deals</h4>
                            </div>
                            <div class="card-body p-0">
                                <div t-if="state.data.my_deals.length === 0" class="p-5 text-center text-muted">
                                    <i class="fa fa-file-text-o fa-3x mb-3 text-secondary"></i>
                                    <h5>No deals available.</h5>
                                    <p class="mb-0 text-muted">You do not have any active quotations or orders assigned to you.</p>
                                    <button class="btn btn-outline-primary mt-3" t-on-click="createQuotation">Create Quotation</button>
                                </div>
                                <div t-else="" class="table-responsive">
                                    <table class="table table-hover table-borderless align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-4">Quotation / Order</th>
                                                <th>Customer</th>
                                                <th>Amount</th>
                                                <th>State</th>
                                                <th>Risk Score</th>
                                                <th>Approval Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.data.my_deals" t-as="deal" t-key="deal.id" class="cursor-pointer" t-on-click="() => this.openDeal(deal.id)">
                                                <td class="ps-4 fw-bold text-primary"><t t-esc="deal.name"/></td>
                                                <td><t t-esc="deal.customer"/></td>
                                                <td class="fw-bold">
                                                    <t t-if="state.data.kpis.currency_position === 'after'">
                                                        <t t-esc="formatCurrency(deal.amount_total)"/> <t t-esc="deal.currency_symbol"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="deal.currency_symbol"/><t t-esc="formatCurrency(deal.amount_total)"/>
                                                    </t>
                                                </td>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill text-bg-{{ deal.state === 'sale' ? 'success' : 'info' }}">
                                                        <t t-esc="deal.state.toUpperCase()"/>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill text-bg-{{ deal.risk_level === 'high' ? 'danger' : (deal.risk_level === 'medium' ? 'warning' : 'success') }}">
                                                        <t t-esc="deal.risk_score"/> (<t t-esc="deal.risk_level"/>)
                                                    </span>
                                                </td>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill text-bg-{{ deal.approval_status === 'approved' ? 'success' : (deal.approval_status === 'rejected' ? 'danger' : (deal.approval_status === 'pending' ? 'warning' : 'secondary')) }}">
                                                        <t t-esc="deal.approval_status === 'none' ? 'None' : deal.approval_status.toUpperCase()"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </t>
</templates>
