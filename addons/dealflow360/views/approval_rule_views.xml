<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_rule_form" model="ir.ui.view">
        <field name="name">dealflow.approval.rule.form</field>
        <field name="model">dealflow.approval.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="min_risk_score"/>
                            <field name="max_risk_score"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="group_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Specific Tiers">
                            <field name="tier_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_approval_rule_list" model="ir.ui.view">
        <field name="name">dealflow.approval.rule.list</field>
        <field name="model">dealflow.approval.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="min_risk_score"/>
                <field name="max_risk_score"/>
                <field name="group_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_approval_rule" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">dealflow.approval.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dealflow360_approval_rules"
              name="Approval Rules"
              parent="menu_dealflow360_config"
              action="action_approval_rule"
              sequence="30"/>
</odoo>
