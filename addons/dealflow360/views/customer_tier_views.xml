<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_dealflow_customer_tier_list" model="ir.ui.view">
        <field name="name">dealflow.customer.tier.list</field>
        <field name="model">dealflow.customer.tier</field>
        <field name="arch" type="xml">
            <list string="Customer Tiers">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dealflow_customer_tier_form" model="ir.ui.view">
        <field name="name">dealflow.customer.tier.form</field>
        <field name="model">dealflow.customer.tier</field>
        <field name="arch" type="xml">
            <form string="Customer Tier">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tier Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dealflow_customer_tier" model="ir.actions.act_window">
        <field name="name">Customer Tiers</field>
        <field name="res_model">dealflow.customer.tier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Customer Tier
            </p>
        </field>
    </record>
</odoo>
