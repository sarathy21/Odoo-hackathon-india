<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Overarching Approval Form -->
    <record id="view_dealflow_approval_form" model="ir.ui.view">
        <field name="name">dealflow.approval.form</field>
        <field name="model">dealflow.approval</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_approve_current_step" type="object" string="Approve" class="btn-primary" invisible="status != 'pending'"/>
                    <button name="action_reject_current_step" type="object" string="Reject" class="btn-danger" invisible="status != 'pending'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Deal Details">
                            <field name="order_id" string="Quotation"/>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        </group>
                        <group string="Customer Negotiation" invisible="not negotiation_id">
                            <field name="negotiation_id" string="Negotiation Request"/>
                            <field name="proposed_risk_level" widget="badge" decoration-danger="proposed_risk_level == 'high'" decoration-warning="proposed_risk_level == 'medium'" decoration-success="proposed_risk_level == 'low'"/>
                            <field name="proposed_risk_score" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook invisible="not negotiation_id">
                        <page string="Proposed Commercial Terms">
                            <field name="negotiation_line_ids">
                                <list>
                                    <field name="product_id"/>
                                    <field name="current_quantity" string="Curr Qty"/>
                                    <field name="requested_quantity" string="Req Qty"/>
                                    <field name="current_unit_price" string="Curr Price"/>
                                    <field name="requested_unit_price" string="Req Price"/>
                                    <field name="current_discount" string="Curr Disc (%)"/>
                                    <field name="requested_discount" string="Req Disc (%)"/>
                                    <field name="change_type" widget="badge" decoration-info="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <group string="Approval Steps">
                            <field name="step_ids" nolabel="1" readonly="1">
                                <list decoration-success="status=='approved'" decoration-danger="status=='rejected'" decoration-warning="status=='pending'">
                                    <field name="rule_id" string="Rule"/>
                                    <field name="status"/>
                                    <field name="approver_id" optional="show"/>
                                </list>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dealflow_approval_list" model="ir.ui.view">
        <field name="name">dealflow.approval.list</field>
        <field name="model">dealflow.approval</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="status=='approved'" decoration-danger="status=='rejected'" decoration-warning="status=='pending'" decoration-muted="status=='stale'">
                <field name="order_id" string="Quotation"/>
                <field name="negotiation_id" widget="badge" decoration-info="negotiation_id != False" string="Negotiation"/>
                <field name="status" widget="badge" decoration-success="status=='approved'" decoration-warning="status=='pending'" decoration-danger="status=='rejected'"/>
            </list>
        </field>
    </record>

    <record id="action_dealflow_approval" model="ir.actions.act_window">
        <field name="name">Active Approvals</field>
        <field name="res_model">dealflow.approval</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Audit Log -->
    <record id="view_dealflow_approval_log_list" model="ir.ui.view">
        <field name="name">dealflow.approval.log.list</field>
        <field name="model">dealflow.approval.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="timestamp"/>
                <field name="order_id"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="old_status"/>
                <field name="new_status"/>
                <field name="reason"/>
            </list>
        </field>
    </record>
    
    <record id="action_dealflow_approval_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">dealflow.approval.log</field>
        <field name="view_mode">list</field>
    </record>
    
</odoo>
