<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dealflow_anomaly_form" model="ir.ui.view">
        <field name="name">dealflow.anomaly.form</field>
        <field name="model">dealflow.anomaly</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_resolve" type="object" string="Resolve" class="oe_highlight" invisible="state == 'resolved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="anomaly_type" readonly="1"/>
                            <field name="severity" readonly="1"/>
                            <field name="source" readonly="1"/>
                        </group>
                        <group>
                            <field name="detected_at" readonly="1"/>
                            <field name="resolved_at" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <group>
                                <field name="description" readonly="1"/>
                                <field name="value" readonly="1"/>
                                <field name="threshold" readonly="1"/>
                                <field name="explanation" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dealflow_anomaly_list" model="ir.ui.view">
        <field name="name">dealflow.anomaly.list</field>
        <field name="model">dealflow.anomaly</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="severity in ('high', 'critical')" decoration-warning="severity=='medium'" decoration-muted="state=='resolved'">
                <field name="order_id"/>
                <field name="anomaly_type"/>
                <field name="severity"/>
                <field name="state"/>
                <field name="detected_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_dealflow_anomaly" model="ir.actions.act_window">
        <field name="name">Anomalies</field>
        <field name="res_model">dealflow.anomaly</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
