<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_dealflow360_root"
              name="DealFlow360"
              web_icon="dealflow360,static/description/icon.png"
              groups="dealflow360.group_dealflow_manager,sales_team.group_sale_salesman"
              sequence="50"/>

    <!-- Client Action for Command Center -->
    <record id="action_dealflow_command_center" model="ir.actions.client">
        <field name="name">DealFlow360 Command Center</field>
        <field name="tag">dealflow_command_center</field>
    </record>

    <!-- Command Center Menu -->
    <menuitem id="menu_dealflow360_command_center"
              name="Command Center"
              parent="menu_dealflow360_root"
              action="action_dealflow_command_center"
              groups="dealflow360.group_dealflow_manager"
              sequence="10"/>

    <!-- Client Action for Sales Representative Workspace -->
    <record id="action_dealflow_sales_rep_workspace" model="ir.actions.client">
        <field name="name">Sales Representative Workspace</field>
        <field name="tag">dealflow_sales_rep_workspace</field>
    </record>

    <!-- Sales Representative Workspace Menu -->
    <menuitem id="menu_dealflow360_sales_workspace"
              name="Sales Workspace"
              parent="menu_dealflow360_root"
              action="action_dealflow_sales_rep_workspace"
              groups="sales_team.group_sale_salesman"
              sequence="15"/>

    <!-- Deals Menu (Points to native Odoo quotations) -->
    <record id="action_dealflow_deals" model="ir.actions.act_window">
        <field name="name">Deals</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="domain">[('state', 'in', ['draft', 'sent', 'sale'])]</field>
    </record>

    <menuitem id="menu_dealflow360_deals"
              name="Deals"
              parent="menu_dealflow360_root"
              action="action_dealflow_deals"
              sequence="20"/>

    <!-- Customer Negotiations Menu -->
    <menuitem id="menu_dealflow360_negotiations"
              name="Customer Negotiations"
              parent="menu_dealflow360_root"
              action="action_dealflow_negotiation"
              groups="dealflow360.group_dealflow_manager"
              sequence="25"/>

    <!-- Approvals Menu -->
    <menuitem id="menu_dealflow360_approvals"
              name="Approvals"
              parent="menu_dealflow360_root"
              action="action_dealflow_approval"
              groups="dealflow360.group_dealflow_manager"
              sequence="30"/>

    <!-- Fulfillment Plans Action Menu (Moved to Config) -->
    <record id="action_dealflow_fulfillment_plan" model="ir.actions.act_window">
        <field name="name">Fulfillment Plans</field>
        <field name="res_model">dealflow.fulfillment.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Configuration Menu -->
    <menuitem id="menu_dealflow360_config"
              name="Configuration"
              parent="menu_dealflow360_root"
              groups="dealflow360.group_dealflow_manager"
              sequence="100"/>

    <menuitem id="menu_dealflow360_monitoring"
              name="Technical &amp; Monitoring"
              parent="menu_dealflow360_config"
              sequence="90"/>

    <menuitem id="menu_dealflow360_fulfillment_plans"
              name="Fulfillment Plans"
              parent="menu_dealflow360_monitoring"
              action="action_dealflow_fulfillment_plan"
              sequence="10"/>

    <menuitem id="menu_dealflow360_deal_health"
              name="Deal Health"
              parent="menu_dealflow360_monitoring"
              action="action_dealflow_deal_health"
              sequence="20"/>

    <menuitem id="menu_dealflow360_anomalies"
              name="Anomalies"
              parent="menu_dealflow360_monitoring"
              action="action_dealflow_anomaly"
              sequence="30"/>

    <menuitem id="menu_dealflow360_logs"
              name="Audit Logs"
              parent="menu_dealflow360_monitoring"
              action="action_dealflow_approval_log"
              sequence="40"/>



    <menuitem id="menu_dealflow360_customer_tier"
              name="Customer Tiers"
              parent="menu_dealflow360_config"
              action="action_dealflow_customer_tier"
              sequence="10"/>

    <menuitem id="menu_dealflow360_discount_rule"
              name="Discount Rules"
              parent="menu_dealflow360_config"
              action="action_dealflow_discount_rule"
              sequence="20"/>

    <menuitem id="menu_dealflow360_approval_rules"
              name="Approval Rules"
              parent="menu_dealflow360_config"
              action="action_approval_rule"
              sequence="30"/>

    <menuitem id="menu_dealflow360_recommendations"
              name="Product Recommendations"
              parent="menu_dealflow360_config"
              action="action_dealflow_product_recommendation"
              sequence="40"/>
</odoo>
