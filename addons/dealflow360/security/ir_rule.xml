<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company record rules for Approval Engine -->
    <record id="dealflow_approval_rule_company_rule" model="ir.rule">
        <field name="name">DealFlow Approval Rule: multi-company</field>
        <field name="model_id" ref="model_dealflow_approval_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="dealflow_product_recommendation_company_rule" model="ir.rule">
        <field name="name">DealFlow Product Recommendation: multi-company</field>
        <field name="model_id" ref="model_dealflow_product_recommendation"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="dealflow_approval_company_rule" model="ir.rule">
        <field name="name">DealFlow Approval: multi-company</field>
        <field name="model_id" ref="model_dealflow_approval"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="dealflow_approval_step_company_rule" model="ir.rule">
        <field name="name">DealFlow Approval Step: multi-company</field>
        <field name="model_id" ref="model_dealflow_approval_step"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="dealflow_approval_log_company_rule" model="ir.rule">
        <field name="name">DealFlow Approval Log: multi-company</field>
        <field name="model_id" ref="model_dealflow_approval_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
