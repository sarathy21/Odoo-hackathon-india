<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dealflow_negotiation_reject_wizard" model="ir.ui.view">
        <field name="name">dealflow.negotiation.reject.wizard.form</field>
        <field name="model">dealflow.negotiation.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Negotiation">
                <sheet>
                    <group>
                        <field name="negotiation_id" invisible="1"/>
                        <field name="reason" placeholder="Provide a reason for rejecting the customer's negotiation request..."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm Rejection" type="object" name="action_confirm_reject" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dealflow_negotiation_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Negotiation</field>
        <field name="res_model">dealflow.negotiation.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
